# =============================================
# WAF Project Environment Variables - Development
# =============================================
# Development environment configuration
# Uses localhost URLs and relaxed security settings
# =============================================

# ===========================================
# Google OAuth2 Configuration
# ===========================================
# Get these from Google Cloud Console -> APIs & Credentials -> OAuth 2.0 Client IDs
# URL: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_dev_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_dev_google_client_secret_here

# ===========================================
# JWT & Authentication Secrets
# ===========================================
# Development secrets (use openssl rand -base64 32 to generate)
# ⚠️ MUST change these in production!
JWT_SECRET=dev-secret-key-32-bytes-long-test
NEXTAUTH_SECRET=dev-nextauth-secret-key-for-testing

# ===========================================
# Domain Configuration
# ===========================================
# Development environment - localhost URLs
DOMAIN=http://localhost:3001
OAUTH_CALLBACK_BASE_URL=http://localhost:8081
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8081/login/oauth2/code/google
OAUTH_DEFAULT_REDIRECT_URL=http://localhost:3001
COOKIE_DOMAIN=localhost

# ===========================================
# InfluxDB Configuration
# ===========================================
# InfluxDB admin credentials (used by docker-compose)
INFLUXDB_ADMIN_USERNAME=admin
INFLUXDB_ADMIN_PASSWORD=dev_influxdb_password

# InfluxDB access token - generate after first setup from UI: http://localhost:8086
INFLUXDB_TOKEN=dev-influxdb-token-replace-with-actual
INFLUXDB_ORG=waf-dev
INFLUXDB_BUCKET=waf-realtime-dev

# ===========================================
# ClickHouse Configuration
# ===========================================
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=dev_clickhouse_password
CLICKHOUSE_DB=waf_analytics

# ===========================================
# Grafana Configuration
# ===========================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=dev_grafana_password

# ===========================================
# Development Settings
# ===========================================
NODE_ENV=development
FRONTEND_PORT=3001

# Development debugging options
DEBUG=true
LOG_LEVEL=debug

# ===========================================
# Optional: Development Configurations
# ===========================================
# Local GeoIP database path (for development)
# GEOIP_DB_PATH=/opt/geoip/GeoLite2-City.mmdb

# Development Kafka topics (if needed)
# KAFKA_TOPIC_REALTIME=waf-realtime-events-dev
# KAFKA_TOPIC_LOGS=waf-logs-dev
