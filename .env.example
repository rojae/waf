# =============================================
# WAF Project Environment Variables Template
# =============================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#   vim .env  # Edit with your values
#
# IMPORTANT: Never commit .env file with real credentials!
# =============================================

# ===========================================
# Google OAuth2 Configuration
# ===========================================
# Get these from Google Cloud Console -> APIs & Credentials -> OAuth 2.0 Client IDs
# URL: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ===========================================
# JWT & Authentication Secrets
# ===========================================
# Generate a secure 32+ character secret for JWT token signing
# Command: openssl rand -base64 32
JWT_SECRET=your_32_character_jwt_secret_here_changeme

# Generate a secure secret for NextAuth.js session encryption
# Command: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_key_here_changeme

# ===========================================
# Domain Configuration
# ===========================================
# For local development, use localhost:
DOMAIN=http://localhost:3001
OAUTH_CALLBACK_BASE_URL=http://localhost:8081
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8081/login/oauth2/code/google
OAUTH_DEFAULT_REDIRECT_URL=http://localhost:3001
COOKIE_DOMAIN=localhost

# For production/ngrok, replace with your actual domain:
# DOMAIN=https://your-domain.com
# OAUTH_CALLBACK_BASE_URL=https://your-domain.com
# GOOGLE_OAUTH_REDIRECT_URI=https://your-domain.com/login/oauth2/code/google
# OAUTH_DEFAULT_REDIRECT_URL=https://your-domain.com
# COOKIE_DOMAIN=your-domain.com

# ===========================================
# InfluxDB Configuration
# ===========================================
# InfluxDB admin credentials (used by docker-compose)
INFLUXDB_ADMIN_USERNAME=admin
INFLUXDB_ADMIN_PASSWORD=changeme_influxdb_password

# InfluxDB access token - IMPORTANT: Generate this after first setup
# Steps:
#   1. Start InfluxDB: docker-compose up -d influxdb
#   2. Login to InfluxDB UI: http://localhost:8086
#   3. Go to Load Data > API Tokens > Generate Token
#   4. Copy the token and paste it here
INFLUXDB_TOKEN=your_influxdb_token_here_get_from_ui

# InfluxDB organization and bucket settings
INFLUXDB_ORG=waf-org
INFLUXDB_BUCKET=waf-realtime

# ===========================================
# ClickHouse Configuration
# ===========================================
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=changeme_clickhouse_password
CLICKHOUSE_DB=waf_analytics

# ===========================================
# Grafana Configuration
# ===========================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_grafana_password

# ===========================================
# Development Settings
# ===========================================
# Set to 'development' for local dev, 'production' for deployment
NODE_ENV=development

# Frontend port (default: 3001)
FRONTEND_PORT=3001

# ===========================================
# Optional: Environment-Specific Settings
# ===========================================
# Development debugging (set these for dev/staging environments)
# DEBUG=true
# LOG_LEVEL=debug

# Production/Staging security settings
# SECURE_COOKIES=true
# CORS_ORIGIN=https://your-domain.com
# RATE_LIMIT_MAX=1000
# RATE_LIMIT_WINDOW=900000

# Data retention policy (for staging/production)
# KAFKA_RETENTION_HOURS=720  # 30 days
# ELASTICSEARCH_RETENTION_DAYS=365  # 1 year
# CLICKHOUSE_RETENTION_DAYS=1095  # 3 years

# ===========================================
# Optional: Kafka Configuration
# ===========================================
# Usually you don't need to change these
# KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# KAFKA_TOPIC_REALTIME=waf-realtime-events
# KAFKA_TOPIC_LOGS=waf-logs

# ===========================================
# Optional: Monitoring & Observability
# ===========================================
# Production monitoring services
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project
# SLACK_WEBHOOK_URL=https://hooks.slack.com/your-webhook

# ===========================================
# Optional: Custom Configurations
# ===========================================
# Custom paths for GeoIP database (if different from default)
# GEOIP_DB_PATH=/path/to/GeoLite2-City.mmdb

# Production backup settings
# BACKUP_S3_BUCKET=your-backup-bucket
# BACKUP_RETENTION_DAYS=90

# ===========================================
# Security Checklist
# ===========================================
# Before deploying to production, ensure:
# [ ] All passwords are changed from defaults
# [ ] JWT_SECRET is at least 32 characters
# [ ] INFLUXDB_TOKEN is generated from InfluxDB UI
# [ ] .env file is added to .gitignore
# [ ] Google OAuth credentials are for production domain
