# =============================================
# WAF Project Environment Variables - Staging
# =============================================
# Staging environment configuration
# Mirrors production setup with test data and shorter retention
# =============================================

# ===========================================
# Google OAuth2 Configuration
# ===========================================
# Get these from Google Cloud Console -> APIs & Credentials -> OAuth 2.0 Client IDs
# URL: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_staging_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_staging_google_client_secret_here

# ===========================================
# JWT & Authentication Secrets
# ===========================================
# Staging secrets (use openssl rand -base64 32 to generate)
# ⚠️ Use different values from production!
JWT_SECRET=staging-secret-key-32-bytes-long
NEXTAUTH_SECRET=staging-nextauth-secret-key-test

# ===========================================
# Domain Configuration
# ===========================================
# Staging domain settings (replace with your actual staging domain)
DOMAIN=https://staging.your-domain.com
OAUTH_CALLBACK_BASE_URL=https://staging.your-domain.com
GOOGLE_OAUTH_REDIRECT_URI=https://staging.your-domain.com/login/oauth2/code/google
OAUTH_DEFAULT_REDIRECT_URL=https://staging.your-domain.com
COOKIE_DOMAIN=staging.your-domain.com

# ===========================================
# InfluxDB Configuration
# ===========================================
# InfluxDB admin credentials (used by docker-compose)
INFLUXDB_ADMIN_USERNAME=admin
INFLUXDB_ADMIN_PASSWORD=staging_influxdb_password

# InfluxDB access token - generate from InfluxDB UI
INFLUXDB_TOKEN=staging-influxdb-token-replace-me
INFLUXDB_ORG=waf-staging
INFLUXDB_BUCKET=waf-realtime-staging

# ===========================================
# ClickHouse Configuration
# ===========================================
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=staging_clickhouse_password
CLICKHOUSE_DB=waf_analytics

# ===========================================
# Grafana Configuration
# ===========================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=staging_grafana_password

# ===========================================
# Staging Settings
# ===========================================
NODE_ENV=production
FRONTEND_PORT=3001

# Staging debugging (more verbose than production)
DEBUG=false
LOG_LEVEL=warn

# ===========================================
# Security & Performance Configurations
# ===========================================
# Staging security settings
SECURE_COOKIES=true
CORS_ORIGIN=https://staging.your-domain.com
RATE_LIMIT_MAX=500
RATE_LIMIT_WINDOW=900000

# Staging data retention policy (shorter than production)
KAFKA_RETENTION_HOURS=168  # 7 days
ELASTICSEARCH_RETENTION_DAYS=30  # 30 days
CLICKHOUSE_RETENTION_DAYS=90  # 90 days

# ===========================================
# Optional: Staging Configurations
# ===========================================
# Staging test settings
# ENABLE_TEST_ROUTES=true
# MOCK_EXTERNAL_APIS=false

# Staging notifications (test Slack channel, etc)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/your-staging-webhook

# Staging GeoIP database path
# GEOIP_DB_PATH=/opt/geoip/GeoLite2-City.mmdb
