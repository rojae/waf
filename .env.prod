# =============================================
# WAF Project Environment Variables - Production
# =============================================
# Production environment configuration
# High security, optimized performance, long retention
# ⚠️ CRITICAL: Change ALL default passwords before deployment!
# =============================================

# ===========================================
# Google OAuth2 Configuration
# ===========================================
# Get these from Google Cloud Console -> APIs & Credentials -> OAuth 2.0 Client IDs
# URL: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_prod_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_prod_google_client_secret_here

# ===========================================
# JWT & Authentication Secrets
# ===========================================
# Production strong secrets (32+ bytes recommended)
# Generate with: openssl rand -base64 32
# ⚠️ CRITICAL: Change these before deployment!
JWT_SECRET=CHANGE-ME-TO-STRONG-32-BYTE-SECRET
NEXTAUTH_SECRET=CHANGE-ME-TO-STRONG-NEXTAUTH-SECRET

# ===========================================
# Domain Configuration
# ===========================================
# Production domain settings (replace with your actual production domain)
DOMAIN=https://your-production-domain.com
OAUTH_CALLBACK_BASE_URL=https://your-production-domain.com
GOOGLE_OAUTH_REDIRECT_URI=https://your-production-domain.com/login/oauth2/code/google
OAUTH_DEFAULT_REDIRECT_URL=https://your-production-domain.com
COOKIE_DOMAIN=your-production-domain.com

# ===========================================
# InfluxDB Configuration
# ===========================================
# InfluxDB admin credentials (used by docker-compose)
# ⚠️ CRITICAL: Change these before deployment!
INFLUXDB_ADMIN_USERNAME=admin
INFLUXDB_ADMIN_PASSWORD=CHANGE-ME-PRODUCTION-INFLUXDB-PASSWORD

# InfluxDB access token - generate from InfluxDB UI
INFLUXDB_TOKEN=CHANGE-ME-TO-PRODUCTION-INFLUXDB-TOKEN
INFLUXDB_ORG=waf-prod
INFLUXDB_BUCKET=waf-realtime-prod

# ===========================================
# ClickHouse Configuration
# ===========================================
# ⚠️ CRITICAL: Change these before deployment!
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=CHANGE-ME-PRODUCTION-CLICKHOUSE-PASSWORD
CLICKHOUSE_DB=waf_analytics

# ===========================================
# Grafana Configuration
# ===========================================
# ⚠️ CRITICAL: Change these before deployment!
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE-ME-PRODUCTION-GRAFANA-PASSWORD

# ===========================================
# Production Settings
# ===========================================
NODE_ENV=production
FRONTEND_PORT=3001

# Production performance optimization
DEBUG=false
LOG_LEVEL=info

# ===========================================
# Security & Performance Configurations
# ===========================================
# Production security settings
SECURE_COOKIES=true
CORS_ORIGIN=https://your-production-domain.com
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW=900000

# Production data retention policy
KAFKA_RETENTION_HOURS=720  # 30 days
ELASTICSEARCH_RETENTION_DAYS=365  # 1 year
CLICKHOUSE_RETENTION_DAYS=1095  # 3 years

# ===========================================
# Optional: Production Configurations
# ===========================================
# Production GeoIP database path
# GEOIP_DB_PATH=/opt/geoip/GeoLite2-City.mmdb

# Production monitoring
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project
# SLACK_WEBHOOK_URL=https://hooks.slack.com/your-production-webhook

# Production backup settings
# BACKUP_S3_BUCKET=your-backup-bucket
# BACKUP_RETENTION_DAYS=90

# ===========================================
# Production Security Checklist
# ===========================================
# Before deploying, ensure:
# [ ] All passwords changed from defaults
# [ ] JWT_SECRET is at least 32 characters (openssl rand -base64 32)
# [ ] INFLUXDB_TOKEN generated from InfluxDB UI
# [ ] Google OAuth credentials match production domain
# [ ] SSL/TLS certificates installed and valid
# [ ] Firewall rules configured
# [ ] Backup strategy tested
# [ ] Monitoring alerts configured
